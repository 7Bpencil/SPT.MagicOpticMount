<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <OutPath>$(SPTPath)\SPT_Runtime\user\mods\7Bpencil.ModularSights</OutPath>
    <StagePath>..\Stage\SPT_Runtime\user\mods\7Bpencil.ModularSights</StagePath>
    <AssemblySearchPaths>
      $(AssemblySearchPaths);
      $(SPTPath)\SPT_Runtime;
      $(SPTPath)\SPT_Runtime\user\mods\WTT-ServerCommonLib;
    </AssemblySearchPaths>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPT.Server" />
    <Reference Include="SPTarkov.Common" />
    <Reference Include="SPTarkov.DI" />
    <Reference Include="SPTarkov.Server.Core" />
    <Reference Include="SPTarkov.Server.Web" />
    <Reference Include="SPTarkov.Reflection" />
    <Reference Include="SemanticVersioning" />
    <Reference Include="Spectre.Console" />
    <Reference Include="Spectre.Console.Ansi" />
    <Reference Include="WTT-ServerCommonLib" />
  </ItemGroup>

</Project>
